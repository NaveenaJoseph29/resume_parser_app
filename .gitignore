# Dependencies - recreated by `npm install`
node_modules/

# Build output - recreated by `npm run build`
dist/
dist-ssr/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local environment files - may contain secrets, never commit
.env
.env.local
.env.*.local

# Editor and OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.local
